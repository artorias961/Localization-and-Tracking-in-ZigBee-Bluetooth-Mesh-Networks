{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build for NRF5340 DK NRF5340 application MCU",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf5340dk_nrf5340_cpuapp",
                "BOARD_ROOT": "${sourceDir}/",
                "hci_rpmsg_OVERLAY_CONFIG": "$env{ZEPHYR_BASE}/../nrf/subsys/partition_manager/partition_manager_enabled.conf",
                "CACHED_CONF_FILE": "${sourceDir}/prj.conf",
                "DTC_OVERLAY_FILE": "${sourceDir}/boards/nrf5340dk_nrf5340_cpuapp.overlay"
            }
        },
        {
            "name": "build_child",
            "displayName": "Build for NRF5340 DK NRF5340 application MCU",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_child",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf5340dk_nrf5340_cpuapp",
                "BOARD_ROOT": "${sourceDir}/",
                "hci_rpmsg_OVERLAY_CONFIG": "$env{ZEPHYR_BASE}/../nrf/subsys/partition_manager/partition_manager_enabled.conf",
                "CACHED_CONF_FILE": "${sourceDir}/prj.conf;${sourceDir}/boards/nrf5340dk_nrf5340_cpuapp.conf",
                "DTC_OVERLAY_FILE": "${sourceDir}/boards/nrf5340dk_nrf5340_cpuapp.overlay"
            }
        }
    ]
}